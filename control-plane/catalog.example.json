{
  "node": {
    "id": "node-1",
    "name": "Primary node",
    "state": "enabled",
    "core": {
      "serverPrivateKey": "base64:REPLACE_WITH_32_BYTE_SERVER_PRIVATE_KEY",
      "idleTimeout": "PT1M30S",
      "allowPrivateEgress": false,
      "grpcListen": "unix:///run/bproxy/control.sock",
      "httpListen": null,
      "observabilityEnabled": true,
      "logLevel": "info"
    }
  },
  "boards": [
    {
      "id": "primary",
      "name": "Primary board",
      "hash": "REPLACE_WITH_BOARD_HASH",
      "state": "enabled",
      "maxLanes": 2
    }
  ],
  "users": [
    {
      "id": "alice",
      "name": "Alice",
      "privateKey": "base64:REPLACE_WITH_32_BYTE_USER_PRIVATE_KEY",
      "state": "enabled",
      "maxSessions": 2,
      "maxLanes": 2
    }
  ],
  "assignment": {
    "boardIds": ["primary"],
    "users": [
      {
        "userId": "alice",
        "boardIds": ["primary"]
      }
    ]
  }
