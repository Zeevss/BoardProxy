# Единственная точка входа наружу: Caddy отдаёт статику панели (SPA) и
# проксирует /api/* во внутренний web-api core. Наружу торчит только этот порт.
:80 {
	encode gzip

	# API управляющего слоя core. handle_path срезает префикс /api, поэтому
	# /api/clients → GET /clients на стороне core.
	handle_path /api/* {
		reverse_proxy core:8080
	}

	# Всё остальное — статика SPA. Неизвестные пути отдаём index.html
	# (клиентский роутинг react-router).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
