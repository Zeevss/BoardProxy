# Скопируйте в .env и заполните: cp .env.example .env

# Пароль входа в админ-панель (POST /login). Обязателен — иначе панель откроется
# без аутентификации всем, кто дотянется до порта.
BPROXY_WEB_UI_PASSWORD=change-me

# Обслуживаемые доски (whiteboard hash). Одна доска или несколько через запятую:
#   BPROXY_BOARD=hashA,hashB
# Сервер поднимет хаб на каждую активную доску (из этого списка и из БД). Можно
# оставить пустым и добавить доски из панели позже, затем перезапустить сервер.
BPROXY_BOARD=

# Освобождение страницы аварийно отключившегося клиента. Heartbeat идёт раз в
# 30 секунд, поэтому значение должно быть заметно больше 30s.
BPROXY_IDLE_TIMEOUT=90s
# 0 отключает policy для тихих, но живых TCP-соединений.
BPROXY_STREAM_IDLE_TIMEOUT=0s

# Защита от исчерпания пула страниц одним ключом/пользователем.
BPROXY_SERVER_MAX_SESSIONS_PER_USER=4

# По умолчанию клиенты не могут ходить в RFC1918/ULA сеть сервера. Loopback и
# link-local запрещены всегда, даже если эта опция включена.
BPROXY_ALLOW_PRIVATE_EGRESS=false

# Порт, на котором панель доступна снаружи (единственный публикуемый порт).
PANEL_PORT=8080
