BPROXY_HUB_PORT=8443
# Keep first-run setup private; put a TLS reverse proxy in front for remote access.
BPROXY_CONTROL_HTTP_PORT=127.0.0.1:8080
BPROXY_SUBSCRIBE_BIND=127.0.0.1
BPROXY_SUBSCRIBE_PORT=8090

# Used only with: docker compose --profile subscribe up
# Persistent API token issued by control-plane with role SUBSCRIBER.
BPROXY_SUBSCRIBE_CONTROL_TOKEN=
BPROXY_SUBSCRIBE_CONTROL_TIMEOUT=10s
# Generate once: openssl rand -base64 32 | tr -d '\n=' | tr '+/' '-_'
BPROXY_SUBSCRIBE_RECOVERY_PRIVATE_KEY=
# JSON array, for example: [{"name":"BoardProxy Android","url":"https://example.com/android"}]
BPROXY_SUBSCRIBE_APPS_JSON=[]

# When enabled, POST /api/v1/users returns one subscription URL instead of keylinks.
CONTROL_SUBSCRIPTION_ENABLED=false
CONTROL_SUBSCRIPTION_PUBLIC_URL=https://subscribe.example.com
CONTROL_SUBSCRIPTION_YANDEX_EDITOR_URL=https://disk.yandex.ru/i/replace-me
CONTROL_SUBSCRIPTION_RECOVERY_KEY_ID=recovery-2026-01
# Derive with: docker compose --profile subscribe run --rm --no-deps subscribe -print-public-key
# Public, but it must correspond to BPROXY_SUBSCRIBE_RECOVERY_PRIVATE_KEY.
CONTROL_SUBSCRIPTION_RECOVERY_SERVER_PUBLIC_KEY=

# Generate once with: openssl rand -base64 32
CONTROL_MASTER_KEY=
CONTROL_MASTER_KEY_ID=control-master-v1
# Rotation-ready keyring; when set, use semicolon-separated id:base64 entries.
# CONTROL_MASTER_KEYS=control-master-v1:...;control-master-v2:...
CONTROL_DB_PASSWORD=boardproxy
CONTROL_GRPC_SERVER_NAMES=hub,localhost
CONTROL_ALLOWED_ORIGINS=
CONTROL_REQUESTS_PER_MINUTE=300
CONTROL_MAXIMUM_BODY_BYTES=2097152
CONTROL_PANEL_SESSION_TTL=PT12H
CONTROL_RAW_RETENTION_DAYS=31
CONTROL_ROLLUP_RETENTION_DAYS=730

# Optional emergency machine-admin token. Normal panel bootstrap uses username/password in the browser.
# Generate with: openssl rand -base64 32
CONTROL_BOOTSTRAP_ADMIN_TOKEN=

# Generate through the Nodes screen, then start: docker compose --profile node up -d node
BPROXY_NODE_SECRET=

# Counters are read inside the node container network namespace.
BPROXY_STATS_INTERFACES=eth0
BPROXY_MAX_OUTBOX_BYTES=268435456
