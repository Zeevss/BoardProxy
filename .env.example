BPROXY_HUB_PORT=8443
BPROXY_CONTROL_HTTP_PORT=8080

# Generate once with: openssl rand -base64 32
CONTROL_MASTER_KEY=
CONTROL_MASTER_KEY_ID=control-master-v1
# Rotation-ready keyring; when set, use semicolon-separated id:base64 entries.
# CONTROL_MASTER_KEYS=control-master-v1:...;control-master-v2:...
CONTROL_DB_PASSWORD=boardproxy
CONTROL_GRPC_SERVER_NAMES=hub,localhost
CONTROL_ALLOWED_ORIGINS=
CONTROL_REQUESTS_PER_MINUTE=300
CONTROL_MAXIMUM_BODY_BYTES=2097152
CONTROL_RAW_RETENTION_DAYS=31
CONTROL_ROLLUP_RETENTION_DAYS=730

# Generate once with: openssl rand -base64 32
# Used only to create/manage persistent API tokens. Rotate after bootstrap.
CONTROL_BOOTSTRAP_ADMIN_TOKEN=

# Generate through the control-plane HTTP API; see control-plane/README.md.
BPROXY_NODE_SECRET=

# Counters are read inside the node container network namespace.
BPROXY_STATS_INTERFACES=eth0
BPROXY_MAX_OUTBOX_BYTES=268435456
