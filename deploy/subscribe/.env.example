# Скопируйте в .env рядом с docker-compose.yml.

# Адрес хаба, по которому сервис будет ходить за конфигурацией. Тот же, на
# котором открывается панель.
SUBSCRIBE_CONTROL_PLANE_URL=https://panel.example.net

# Сервисный токен: Настройки → Сервис подписок → «Сервисный токен».
# Показывается один раз, перевыпуск обесценивает предыдущий.
SUBSCRIBE_CONTROL_PLANE_TOKEN=

# Порт наружу. По умолчанию только loopback — публикует реверс-прокси.
SUBSCRIBE_BIND=127.0.0.1
SUBSCRIBE_PORT=8090

# Тег образа. latest — последний релиз, edge — последняя сборка с main.
BPROXY_IMAGE_TAG=latest
