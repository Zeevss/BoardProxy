# Скопируйте в .env рядом с docker-compose.yml.
#
# Секрет выдаёт панель при создании ноды и показывает один раз: хаб хранит
# только его хеш. Живёт пятнадцать минут — если не успели, выпустите новый из
# карточки ноды.
BPROXY_NODE_SECRET=

# Интерфейс для счётчиков трафика. Посмотреть свой: ip -br link
BPROXY_STATS_INTERFACES=eth0

# Тег образа. latest — последний релиз, edge — последняя сборка с main.
BPROXY_IMAGE_TAG=latest
